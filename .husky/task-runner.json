{
   "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
   "tasks": [
      {
         "name": "dotnet-format",
         "group": "pre-commit",
         "command": "dotnet",
         "args": [ "format", "Cinema.slnx", "--include", "${staged}" ],
         "include": [ "**/*.cs" ]
      },
      {
         "name": "gitleaks",
         "group": "pre-commit",
         "command": "gitleaks",
         "args": [ "protect", "--staged", "--redact", "-v" ]
      }
   ]
}
